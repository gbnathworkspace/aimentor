# React SPA configuration (client-side only — VITE_ vars are bundled, never put secrets here)

# FastAPI backend base URL.
#   dev: http://localhost:8000 (Vite dev server calls FastAPI cross-origin via CORS)
#   prod: leave empty ('') — FastAPI serves the SPA same-origin
VITE_API_BASE=http://localhost:8000

# Clerk publishable key (non-secret; same value as the old NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
