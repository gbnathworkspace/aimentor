[Unit]
Description=layered-memory-service
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/layered-memory-service
EnvironmentFile=/etc/layered-memory.env
ExecStart=/home/ec2-user/layered-memory-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
