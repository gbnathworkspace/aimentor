# React SPA configuration (client-side only — VITE_ vars are bundled, never put secrets here)

# FastAPI backend base URL.
#   dev: http://localhost:8000 (Vite dev server calls FastAPI cross-origin via CORS)
#   prod: leave empty ('') — FastAPI serves the SPA same-origin
VITE_API_BASE=http://localhost:8000

# PostHog analytics (page views + time per screen). Public project key, safe to bundle.
# Leave empty to turn analytics off.
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com   (use https://eu.i.posthog.com for an EU project)
